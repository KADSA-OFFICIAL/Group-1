[gd_resource type="Theme" load_steps=4 format=3]

; 메뉴 버튼 테마(#624) — 일시정지 메뉴와 타이틀의 "게임 시작"이 같이 쓴다.
; 상자·테두리 없이 글자만 둔다. 평소에는 흐린 회색, 고른(포커스) 버튼은 밝은
; 미색이고 양옆의 붉은 선은 `scripts/ui/menu_button.gd`가 긋는다.
; 본편이 키보드 전용이라 포커스가 곧 "지금 고른 것"이고, 마우스를 올리면 그 버튼이
; 포커스를 가져가므로(pause_menu.gd) 호버도 같은 색으로 둔다.

[ext_resource type="FontFile" path="res://assets/fonts/NotoSansKR-VF.ttf" id="1_noto"]

[sub_resource type="FontVariation" id="Font_bold"]
base_font = ExtResource("1_noto")
variation_opentype = {
2003265652: 650
}

[sub_resource type="StyleBoxEmpty" id="StyleBox_empty"]
content_margin_left = 24.0
content_margin_top = 10.0
content_margin_right = 24.0
content_margin_bottom = 10.0

[resource]
Button/colors/font_color = Color(0.5, 0.5, 0.55, 1)
Button/colors/font_disabled_color = Color(0.5, 0.5, 0.55, 1)
Button/colors/font_focus_color = Color(0.97, 0.93, 0.87, 1)
Button/colors/font_hover_color = Color(0.97, 0.93, 0.87, 1)
Button/colors/font_hover_pressed_color = Color(1, 0.97, 0.93, 1)
Button/colors/font_pressed_color = Color(1, 0.97, 0.93, 1)
Button/colors/font_outline_color = Color(0, 0, 0, 1)
Button/constants/outline_size = 4
Button/fonts/font = SubResource("Font_bold")
Button/styles/disabled = SubResource("StyleBox_empty")
Button/styles/focus = SubResource("StyleBox_empty")
Button/styles/hover = SubResource("StyleBox_empty")
Button/styles/hover_pressed = SubResource("StyleBox_empty")
Button/styles/normal = SubResource("StyleBox_empty")
Button/styles/pressed = SubResource("StyleBox_empty")
