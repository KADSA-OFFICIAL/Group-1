[ext_resource type="Script" path="res://scripts/ui/settings_panel.gd" id="1_settings_script"]
[ext_resource type="FontFile" path="res://assets/fonts/YeonSung-Regular.ttf" id="2_title_font"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansKR-VF.ttf" id="3_body_font"]
[ext_resource type="Theme" path="res://assets/ui/menu_button_theme.tres" id="4_button_theme"]
[ext_resource type="Script" path="res://scripts/ui/menu_button.gd" id="5_menu_button"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
; 설정창 바탕(#781) — 소지품 창(#745)·수첩과 같은 어두운 갈색 종이 톤.
bg_color = Color(0.09, 0.085, 0.08, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.36, 0.33, 0.28, 1)

[node name="SettingsPanel" type="Control"]
; 타이틀 위에 얹는 설정창(#781). 다른 화면(일시정지 메뉴 등)에서도 인스턴스해 쓸 수
; 있게 독립 씬으로 둔다. 열고 닫는 것은 `open()`/`close()`, 닫히면 `closed`를 쏜다.
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings_script")

[node name="Dim" type="ColorRect" parent="."]
; mouse_filter 기본값(STOP)이라 아래 타이틀 버튼이 클릭을 못 받는다.
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.03, 0.72)

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(560, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Panel/Margin/Rows"]
; 제목은 소지품 창과 같은 연성 + 붉은 그림자.
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.86, 0.75, 1)
theme_override_colors/font_shadow_color = Color(0.42, 0.07, 0.06, 1)
