[node name="BloodSplatter" type="TextureRect" parent="Root/Box/Title"]
; 제목 뒤 핏자국(#627) — `tools/gen_blood_splatter.py`가 굽는다. 왼쪽 아래에서
; 오른쪽 위로 뿌려진 방향성 있는 자국이라 출발점이 제목 왼쪽 아래에 오게 둔다.
; show_behind_parent로 제목 글자 **뒤에** 그린다(자식은 원래 부모 위에 그려진다).
show_behind_parent = true
texture_filter = 1
layout_mode = 0
offset_left = 10.0
offset_top = -84.0
offset_right = 370.0
offset_bottom = 124.0
mouse_filter = 2
texture = ExtResource("5_blood")

