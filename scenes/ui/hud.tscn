[node name="TopLeft" type="PanelContainer" parent="Root"]
; 세 줄이다(#529에서 단서 줄이 붙었다) — 목표 / 소지품 / 단서. 줄을 더 넣으면
; 아래 CloseUp 패널도 같이 내려야 한다(겹치면 목표 글이 가려진다).
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 392.0
offset_bottom = 122.0

