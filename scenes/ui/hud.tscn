theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="TextRows" type="VBoxContainer" parent="Root/TopLeft/Margin"]
layout_mode = 2

[node name="ObjectiveLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
text = "목표: 학교를 탈출하세요."

[node name="InventoryLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
text = "소지품: 없음"

; 확인한 단서 수(#529). 세는 규칙은 game_state.clue_score() 하나뿐이라
; 엔딩의 "알아낸 것 N / M"과 늘 같은 숫자다.
[node name="ClueLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
text = "단서: 0 / 0"

[node name="CloseUp" type="PanelContainer" parent="Root"]
; 근접 클로즈업(#451). 목표·소지품·단서 패널(TopLeft, 16~122) **아래**에 둔다 —
; 겹치면 목표 글이 가려진다. #529에서 단서 줄이 붙어 30px 내려왔다.
; 평소에는 visible = false다.
visible = false
layout_mode = 1
offset_left = 16.0
offset_top = 134.0
offset_right = 176.0
offset_bottom = 350.0

