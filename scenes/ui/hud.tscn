[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/subtitle_dialogue.tscn" id="2_subtitle"]
[ext_resource type="Script" path="res://scripts/ui/janitor_alert.gd" id="3_alert"]
[ext_resource type="Script" path="res://scripts/ui/hud_waypoint.gd" id="4_waypoint"]
[ext_resource type="FontFile" path="res://assets/fonts/YeonSung-Regular.ttf" id="5_title_font"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansKR-VF.ttf" id="6_body_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_inv_panel"]
; 소지품 창 바탕(#745) — 수첩(`journal_panel.tscn`의 Paper)과 같은 어두운 갈색 종이 톤.
bg_color = Color(0.09, 0.085, 0.08, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.36, 0.33, 0.28, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_inv_slot_filled"]
; 물건이 든 칸 — 테두리를 또렷하게(사용자: "물품 테두리 강조").
bg_color = Color(0.05, 0.046, 0.042, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.62, 0.55, 0.43, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_inv_slot_empty"]
; 빈 칸 — 같은 두께, 어둡게. 몇 칸이 남았는지는 보이되 든 칸보다 앞에 나서지 않는다.
bg_color = Color(0.045, 0.042, 0.04, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.24, 0.22, 0.19, 1)

[node name="HUD" type="CanvasLayer"]
layer = 3
script = ExtResource("1_hud_script")
slot_style_filled = SubResource("StyleBoxFlat_inv_slot_filled")
slot_style_empty = SubResource("StyleBoxFlat_inv_slot_empty")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="JanitorAlert" type="Control" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_alert")

[node name="TopLeft" type="PanelContainer" parent="Root"]
; 엔딩 조건 표시(#540, #545) — 진엔딩 / 엔딩2 / 엔딩1
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 448.0
offset_bottom = 106.0

[node name="Margin" type="MarginContainer" parent="Root/TopLeft"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="TextRows" type="VBoxContainer" parent="Root/TopLeft/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TrueEndingLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
theme_override_colors/font_color = Color(1.0, 0.85, 0.50, 1)
text = "진엔딩: 0/6 (4층:0/2, 3층:0/2, 2층:0/1, 1층:0/1)"

[node name="ReportEndingLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.70, 0.85, 1.0, 1)
text = "엔딩 2: 0/3 (2층:0/1, 1층:0/2) [1개+ 필요]"

[node name="BasicEndingLabel" type="Label" parent="Root/TopLeft/Margin/TextRows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.78, 1)
text = "엔딩 1: 1층 열쇠"

[node name="TopRight" type="PanelContainer" parent="Root"]
; 목표 및 소지품 표시(#545)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -380.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 86.0
grow_horizontal = 0

[node name="Margin" type="MarginContainer" parent="Root/TopRight"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="TextRows" type="VBoxContainer" parent="Root/TopRight/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ObjectiveLabel" type="Label" parent="Root/TopRight/Margin/TextRows"]
layout_mode = 2
text = "목표: 학교를 탈출하세요."

[node name="InventoryLabel" type="Label" parent="Root/TopRight/Margin/TextRows"]
layout_mode = 2
text = "소지품: 없음"

[node name="KeyHintLabel" type="Label" parent="Root/TopRight/Margin/TextRows"]
; 여는 키 안내(#742). 수첩(J)은 새 내용이 풀릴 때 2.6초짜리 알림에만 나왔고 소지품(R)은
; 어디에도 안 나왔다. 상자가 이만큼 길어지므로 그 아래에 붙는 수첩 알림(`journal_panel.tscn`의
; Toast)과 수위 화살표 위쪽 여백(`janitor_alert.gd`의 TOP_MARGIN)을 같이 내렸다.
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.68, 1)
theme_override_font_sizes/font_size = 13
text = "[J] 수첩     [R] 소지품"

[node name="CloseUp" type="PanelContainer" parent="Root"]
; 근접 클로즈업(#451). 층수 표시(y=114~160) 아래에 둔다 — 겹치지 않게 offset_top = 175.0.
; 평소에는 visible = false다.
visible = false
layout_mode = 1
offset_left = 16.0
offset_top = 175.0
offset_right = 176.0
offset_bottom = 391.0

[node name="Margin" type="MarginContainer" parent="Root/CloseUp"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Rows" type="VBoxContainer" parent="Root/CloseUp/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Image" type="TextureRect" parent="Root/CloseUp/Margin/Rows"]
layout_mode = 2
custom_minimum_size = Vector2(138, 192)
; 도트 그림이라 Nearest다 — 46x64를 3배로 키워 보여 준다.
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="Caption" type="Label" parent="Root/CloseUp/Margin/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.76, 0.72, 1)
text = ""
horizontal_alignment = 1
autowrap_mode = 2

[node name="InventoryPanel" type="PanelContainer" parent="Root"]
; 소지품 창(#745). 사용자가 실제 게임 캡처 시안 셋 중 'A 수첩 톤'을 골랐다 — 회색 라운드
; 상자 + 글자만 있던 칸이 웹 폼처럼 보였다. 칸 안에는 그림, 이름은 칸 아래(`hud.gd`가 채운다).
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_inv_panel")

