[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/journal_panel.gd" id="1_journal_script"]
[ext_resource type="FontFile" path="res://assets/fonts/YeonSung-Regular.ttf" id="2_title_font"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansKR-VF.ttf" id="3_body_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_paper"]
bg_color = Color(0.09, 0.085, 0.08, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.36, 0.33, 0.28, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="JournalPanel" type="CanvasLayer"]
process_mode = 3
; 일시정지 메뉴(4)와 같은 층 — HUD·UI(FadeRect)가 3이라 그 위에 온다.
layer = 4
script = ExtResource("1_journal_script")

[node name="Root" type="Control" parent="."]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.03, 0.72)

[node name="Paper" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -520.0
offset_top = -380.0
offset_right = 520.0
offset_bottom = 380.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_paper")

[node name="Margin" type="MarginContainer" parent="Root/Paper"]
layout_mode = 2
theme_override_constants/margin_left = 44
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 44
theme_override_constants/margin_bottom = 22

[node name="Rows" type="VBoxContainer" parent="Root/Paper/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Root/Paper/Margin/Rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.86, 0.75, 1)
