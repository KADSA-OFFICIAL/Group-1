[node name="Toast" type="Label" parent="."]
; 새 내용이 적혔다는 알림 — 오른쪽 위 목표·소지품 상자(HUD TopRight, y 16~86) 바로 아래.
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
