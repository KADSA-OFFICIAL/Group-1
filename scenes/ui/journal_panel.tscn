[node name="Scroll" type="ScrollContainer" parent="Root/Paper/Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Text" type="RichTextLabel" parent="Root/Paper/Margin/Rows/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_fonts/normal_font = ExtResource("3_body_font")
theme_override_font_sizes/normal_font_size = 20
theme_override_constants/line_separation = 6
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3

[node name="Hint" type="Label" parent="Root/Paper/Margin/Rows"]
layout_mode = 2
