position = Vector2(377.5, 1780.4)
collision_layer = 2
collision_mask = 0
script = ExtResource("3_interactable")
message = "체육창고 구석에 체육복 상의가 개켜져 있다. 이름표는 3학년 1반 강유진. 주머니에서 나온 쪽지 — '유진아 후배 병원 갔다더라.' 뒷면에 다른 글씨, 굵고 눌러쓴 어른 글씨. '아무도 안 도와주니까 내가 한다.'"
